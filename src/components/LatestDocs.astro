---
import { getCollection } from 'astro:content';

interface Props {
  directory?: string;
  limit?: number;
  title?: string;
  debug?: boolean;
}

const {
  directory = 'all',
  limit = 6,
  title = 'Dernières mises à jour',
  debug = false,
} = Astro.props;

const normalizedDirectory = normalizePath(directory);

const showAllDirectories =
  normalizedDirectory === 'all' ||
  normalizedDirectory === '*' ||
  normalizedDirectory === '';

const allDocs = await getCollection('docs');

/**
 * Normalise un chemin ou un identifiant :
 * - remplace les antislashs Windows ;
 * - retire les slashs au début et à la fin ;
 * - convertit en minuscules.
 */
function normalizePath(value: string): string {
  return value
    .replace(/\\/g, '/')
    .replace(/^\/+|\/+$/g, '')
    .toLowerCase();
}

/**
 * Retourne la date de référence d'une page.
 *
 * Priorité :
 * 1. lastUpdated
 * 2. date
 * 3. aucune date
 */
function getEntryDate(
  entry: (typeof allDocs)[number],
): unknown {
  if (entry.data.lastUpdated) {
    return entry.data.lastUpdated;
  }

  if (
    'date' in entry.data &&
    entry.data.date
  ) {
    return entry.data.date;
  }

  return undefined;
}

/**
 * Indique le type de date utilisé.
 */
function getDateType(
  entry: (typeof allDocs)[number],
): 'updated' | 'published' | null {
  if (entry.data.lastUpdated) {
    return 'updated';
  }

  if (
    'date' in entry.data &&
    entry.data.date
  ) {
    return 'published';
  }

  return null;
}

/**
 * Retourne un timestamp exploitable pour le tri.
 */
function getTimestamp(value: unknown): number {
  if (!value) return 0;

  const date =
    value instanceof Date
      ? value
      : new Date(String(value));

  const timestamp = date.getTime();

  return Number.isNaN(timestamp)
    ? 0
    : timestamp;
}

/**
 * Détermine si une entrée appartient au répertoire demandé.
 *
 * Avec directory="all", toutes les pages sont retenues.
 */
function belongsToDirectory(
  entry: (typeof allDocs)[number],
): boolean {
  if (showAllDirectories) {
    return true;
  }

  const id = normalizePath(entry.id);

  const frontmatterSlug =
    'slug' in entry.data &&
    typeof entry.data.slug === 'string'
      ? normalizePath(entry.data.slug)
      : '';

  return (
    id === normalizedDirectory ||
    id.startsWith(`${normalizedDirectory}/`) ||
    frontmatterSlug === normalizedDirectory ||
    frontmatterSlug.startsWith(
      `${normalizedDirectory}/`,
    )
  );
}

/**
 * Exclut les pages d'accueil.
 *
 * Avec directory="all", toutes les pages index sont exclues.
 */
function isDirectoryIndex(
  entry: (typeof allDocs)[number],
): boolean {
  const id = normalizePath(entry.id);

  if (showAllDirectories) {
    return (
      id === 'index' ||
      id.endsWith('/index')
    );
  }

  return (
    id === normalizedDirectory ||
    id === `${normalizedDirectory}/index`
  );
}

/**
 * Génère l'URL publique d'une page.
 *
 * Si un slug personnalisé est défini, il est utilisé.
 * Sinon, l'identifiant Astro est utilisé.
 */
function entryUrl(
  entry: (typeof allDocs)[number],
): string {
  const rawSlug =
    'slug' in entry.data &&
    typeof entry.data.slug === 'string'
      ? entry.data.slug
      : entry.id;

  const normalizedSlug = rawSlug
    .replace(/\\/g, '/')
    .replace(/^\/+|\/+$/g, '')
    .replace(/\/index$/, '');

  return `/${normalizedSlug}/`;
}

/**
 * Formate une date en français.
 */
function formatDate(value: unknown): string {
  if (!value) return '';

  const date =
    value instanceof Date
      ? value
      : new Date(String(value));

  if (Number.isNaN(date.getTime())) {
    return '';
  }

  return new Intl.DateTimeFormat('fr-FR', {
    day: '2-digit',
    month: 'long',
    year: 'numeric',
  }).format(date);
}

/**
 * Texte affiché devant la date.
 */
function getDateLabel(
  type: 'updated' | 'published' | null,
): string {
  if (type === 'updated') {
    return 'Mis à jour le';
  }

  if (type === 'published') {
    return 'Publié le';
  }

  return '';
}

const latestDocs = allDocs
  .filter((entry) => {
    const isDraft =
      entry.data.draft === true;

    const referenceDate =
      getEntryDate(entry);

    const timestamp =
      getTimestamp(referenceDate);

    return (
      belongsToDirectory(entry) &&
      !isDirectoryIndex(entry) &&
      !isDraft &&
      timestamp > 0
    );
  })
  .sort((a, b) => {
    const dateA = getTimestamp(
      getEntryDate(a),
    );

    const dateB = getTimestamp(
      getEntryDate(b),
    );

    return dateB - dateA;
  })
  .slice(0, limit);

if (debug) {
  console.log(
    `[LatestDocs] Répertoire demandé : ${normalizedDirectory}`,
  );

  console.log(
    `[LatestDocs] Mode global : ${showAllDirectories}`,
  );

  console.table(
    allDocs.map((entry) => {
      const referenceDate =
        getEntryDate(entry);

      return {
        id: entry.id,
        title: entry.data.title,
        slug:
          'slug' in entry.data
            ? entry.data.slug
            : undefined,
        lastUpdated:
          entry.data.lastUpdated,
        date:
          'date' in entry.data
            ? entry.data.date
            : undefined,
        dateUtilisee:
          referenceDate,
        typeDate:
          getDateType(entry),
        timestamp:
          getTimestamp(referenceDate),
        draft:
          entry.data.draft,
        appartient:
          belongsToDirectory(entry),
        index:
          isDirectoryIndex(entry),
        retenu:
          latestDocs.some(
            (doc) =>
              doc.id === entry.id,
          ),
      };
    }),
  );
}
---

<section class="latest-docs">
  <h2>{title}</h2>

  {
    latestDocs.length > 0 ? (
      <ul>
        {latestDocs.map((entry) => {
          const referenceDate =
            getEntryDate(entry);

          const timestamp =
            getTimestamp(referenceDate);

          const dateType =
            getDateType(entry);

          const dateLabel =
            getDateLabel(dateType);

          return (
            <li>
              <a href={entryUrl(entry)}>
                <span class="latest-docs__content">
                  <strong>
                    {entry.data.title}
                  </strong>

                  {entry.data.description && (
                    <span class="latest-docs__description">
                      {entry.data.description}
                    </span>
                  )}
                </span>

                <span class="latest-docs__date">
                  <span class="latest-docs__date-label">
                    {dateLabel}
                  </span>

                  <time
                    datetime={new Date(
                      timestamp,
                    ).toISOString()}
                  >
                    {formatDate(referenceDate)}
                  </time>
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    ) : (
      <p class="latest-docs__empty">
        Aucune page datée n’est disponible dans
        cette rubrique.
      </p>
    )
  }
</section>

<style>
  .latest-docs {
    margin-block: 2rem;
  }

  .latest-docs ul {
    display: grid;
    gap: 0.75rem;
    padding: 0;
    list-style: none;
  }

  .latest-docs li {
    margin: 0;
  }

  .latest-docs a {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    color: inherit;
    text-decoration: none;
    transition:
      border-color 150ms ease,
      background-color 150ms ease,
      transform 150ms ease;
  }

  .latest-docs a:hover {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-gray-6);
    transform: translateY(-1px);
  }

  .latest-docs__content {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.25rem;
  }

  .latest-docs__description {
    color: var(--sl-color-gray-2);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .latest-docs__date {
    display: flex;
    flex-shrink: 0;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.15rem;
    color: var(--sl-color-gray-2);
    font-size: 0.8rem;
    white-space: nowrap;
  }

  .latest-docs__date-label {
    font-size: 0.7rem;
    opacity: 0.8;
  }

  .latest-docs time {
    font-weight: 500;
  }

  .latest-docs__empty {
    color: var(--sl-color-gray-2);
    font-style: italic;
  }

  @media (max-width: 40rem) {
    .latest-docs a {
      flex-direction: column;
    }

    .latest-docs__date {
      align-items: flex-start;
    }
  }
</style>